# Required existing project settings
DATABASE_URL=postgresql://sih_user:sih_password@localhost:5432/sih26001
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional integrations. Leave blank unless you actually use the service.
# Open-Meteo: no API key required.
OPEN_METEO_API_KEY=

# OpenStreetMap/Overpass: no API key required for the public demo endpoint.
# Respect provider usage policies and rate limits.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# NASA Earthdata: catalog search is public; protected downloads may require Earthdata Login/token.
NASA_EARTHDATA_TOKEN=

# Optional Mapbox integration (not required by the Phase 8 demo map).
MAPBOX_ACCESS_TOKEN=

# Optional Google Maps Platform direct API/SDK integration.
# Do NOT commit a real key to Git. Restrict the key in Google Cloud Console.
GOOGLE_MAPS_API_KEY=
